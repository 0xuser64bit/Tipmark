# Every variable in this file is public. The deployment holds no secrets:
# there is no database, no session, no upload provider, and no third-party
# account. Browser bundles inline every NEXT_PUBLIC_* value at build time —
# redeploy after changing one.
#
# Every variable has a fallback, so the app runs with this file untouched. The
# defaults are fine for a first look and wrong for a deployment.

# ── Set these for any real deployment ─────────────────────────────────────
# Primary RPC endpoint, used by browser wallet connections and by writes.
# Defaults to the public Devnet endpoint, which is rate-limited and suitable
# only for light testing. This URL reaches the browser, so prefer a
# domain-restricted key.
NEXT_PUBLIC_SOLANA_RPC_URL=""

# Program address. Defaults to the committed deployment. Point this at your own
# only if you have deployed the program yourself: it must match Anchor.toml and
# idls/tipmark_protocol.json, and its config PDA must already be initialized on
# the selected cluster.
NEXT_PUBLIC_TIPMARK_PROGRAM_ID=""

# Domain you control, without https://. Used for canonical links and share
# cards.
NEXT_PUBLIC_BRAND_DOMAIN="tipmark-platform.vercel.app"

# ── Optional ──────────────────────────────────────────────────────────────
# Only devnet and localnet are supported; any other value makes protocol reads
# and writes throw. Set localnet only for `bun run protocol:integration`.
NEXT_PUBLIC_SOLANA_CLUSTER="devnet"

# Ordered, comma-separated read-failover endpoints for server reads. Must be the
# same cluster as the primary. Writes never fail over.
NEXT_PUBLIC_SOLANA_RPC_URLS=""

# Gateway overrides, comma-separated. Devnet Irys uploads never settle to
# Arweave, so arweave.net cannot serve them; off mainnet an Irys node is always
# tried first regardless of the order given here.
NEXT_PUBLIC_ARWEAVE_GATEWAY_URLS="https://devnet.irys.xyz,https://gateway.irys.xyz"
NEXT_PUBLIC_IPFS_GATEWAY_URLS="https://ipfs.io/ipfs,https://dweb.link/ipfs"

# ── Release gate only ─────────────────────────────────────────────────────
# Read by `bun run protocol:release-check`, never by the running app. Public
# addresses and published governance metadata only — never a private key.
TIPMARK_RELEASE_CLUSTER="devnet"
TIPMARK_PROGRAM_ADDRESS=""
TIPMARK_UPGRADE_AUTHORITY=""
TIPMARK_MULTISIG_ADDRESS=""
TIPMARK_MULTISIG_THRESHOLD="2"
TIPMARK_MULTISIG_SIGNERS=""
