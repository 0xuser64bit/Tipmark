# Public identity. The domain is used for canonical links and share cards.
NEXT_PUBLIC_BRAND_DOMAIN="tipmark-platform.vercel.app"

# Solana RPC. Use a dedicated Devnet provider for the current protocol
# deployment. The public endpoint is suitable only for light testing.
NEXT_PUBLIC_SOLANA_RPC_URL=""
# Optional ordered read failover endpoints. The primary RPC above remains the
# wallet/write endpoint; these are used for server-side reads.
NEXT_PUBLIC_SOLANA_RPC_URLS=""

# Solana protocol deployment. The program address must match Anchor.toml and
# the generated IDL, and its config PDA must already be initialized on the
# selected cluster. Only devnet and localnet are accepted.
NEXT_PUBLIC_SOLANA_CLUSTER="devnet"
NEXT_PUBLIC_TIPMARK_PROGRAM_ID=""
NEXT_PUBLIC_SOLANA_WS_URL=""
# Optional gateway overrides. Devnet Irys uploads never settle to Arweave, so
# arweave.net cannot serve them; off mainnet an Irys node is always tried first
# regardless of the order given here.
NEXT_PUBLIC_ARWEAVE_GATEWAY_URLS="https://devnet.irys.xyz,https://gateway.irys.xyz"
NEXT_PUBLIC_IPFS_GATEWAY_URLS="https://ipfs.io/ipfs,https://dweb.link/ipfs"

# Devnet release-check inputs. These are public addresses and governance
# metadata, not signer secrets. Every variable in this file is public.
TIPMARK_RELEASE_CLUSTER="devnet"
TIPMARK_PROGRAM_ADDRESS=""
TIPMARK_UPGRADE_AUTHORITY=""
TIPMARK_MULTISIG_ADDRESS=""
TIPMARK_MULTISIG_THRESHOLD="2"
TIPMARK_MULTISIG_SIGNERS=""
