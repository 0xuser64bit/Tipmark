# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres"

# Auth (NextAuth / Google OAuth)
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_BRAND_DOMAIN="tipmark.xyz"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Image uploads (EdgeStore)
EDGE_STORE_ACCESS_KEY=""
EDGE_STORE_SECRET_KEY=""

# Legacy direct-payment RPC. Keep this on mainnet while the protocol flag is
# disabled. A dedicated provider is required for production payment traffic.
NEXT_PUBLIC_SOLANA_RPC_URL=""
# Optional ordered read failover endpoints. The primary RPC above remains the
# wallet/write endpoint; these are used for server-side reads and indexing.
NEXT_PUBLIC_SOLANA_RPC_URLS=""

# Decentralized protocol rollout. New protocol transactions stay disabled until
# a reviewed deployment exists on the selected cluster. Use localnet or devnet
# during development; mainnet-beta must be an explicit release decision.
NEXT_PUBLIC_TIPMARK_PROTOCOL_ENABLED="false"
NEXT_PUBLIC_SOLANA_CLUSTER="devnet"
NEXT_PUBLIC_TIPMARK_PROGRAM_ID=""
NEXT_PUBLIC_SOLANA_WS_URL=""
NEXT_PUBLIC_ARWEAVE_GATEWAY_URLS="https://arweave.net,https://gateway.irys.xyz"
NEXT_PUBLIC_IPFS_GATEWAY_URLS="https://ipfs.io/ipfs,https://dweb.link/ipfs"
