# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres"

# Auth (NextAuth / Google OAuth)
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Image uploads (EdgeStore)
EDGE_STORE_ACCESS_KEY=""
EDGE_STORE_SECRET_KEY=""

# Solana RPC — strongly recommended to set a dedicated mainnet RPC
# (Helius, QuickNode, Triton, etc.). The public cluster endpoint is
# rate-limited and unreliable for real payment traffic. Falls back to
# the public mainnet cluster when empty.
NEXT_PUBLIC_SOLANA_RPC_URL=""
