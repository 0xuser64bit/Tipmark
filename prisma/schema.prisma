// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String        @id @default(uuid())
  email              String        @unique
  username           String?
  description        String?
  display_name       String?
  profile_image      String?
  cover_image        String?
  x_username         String?
  instagram_username String?
  github_username    String?
  linkedin_username  String?
  solana_public_key  String?
  updates            Boolean?      @default(false)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  Transaction        Transaction[]
}

model WalletChallenge {
  id        String    @id @default(uuid())
  nonce     String    @unique
  wallet    String
  email     String?
  domain    String
  uri       String
  cluster   String
  issuedAt  DateTime
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([wallet, expiresAt])
}

model ProtocolTip {
  signature     String   @id
  cluster       String
  program       String
  profile       String
  profileOwner  String
  supporter     String
  payoutWallet  String
  amountLamports String
  reference     String
  slot          BigInt
  blockTime     DateTime?
  status        String
  verifiedAt    DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([cluster, program, profile, slot])
  @@index([profileOwner, slot])
}

model ProtocolIndexerCheckpoint {
  id               String   @id
  cluster          String
  program          String
  revision         Int      @default(0)
  headSlot         BigInt   @default(0)
  headSignature    String?
  backfillBefore   String?
  backfillComplete Boolean  @default(false)
  updatedAt        DateTime @updatedAt

  @@unique([cluster, program])
}

model Transaction {
  id            String   @id @default(uuid())
  user          User     @relation(fields: [user_id], references: [email])
  user_id       String
  hash          String   @unique
  amount        String
  fromPublicKey String
  toPublicKey   String
  status        String // confirmed, finalized, processed
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
