{
  "name": "tipmark",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "protocol:build": "NO_DNA=1 anchor build --ignore-keys && bun scripts/normalize-protocol-idl.mjs target/idl/tipmark_protocol.json && cp target/idl/tipmark_protocol.json idls/tipmark_protocol.json",
    "protocol:generate": "bun scripts/generate-protocol-client.mjs",
    "protocol:test": "NO_DNA=1 cargo test --workspace && NO_DNA=1 cargo clippy --workspace --all-targets -- -D warnings && bun test",
    "protocol:integration": "NO_DNA=1 bun run protocol:build && NEXT_PUBLIC_SOLANA_CLUSTER=localnet NEXT_PUBLIC_SOLANA_RPC_URL=http://127.0.0.1:18899 NO_DNA=1 bun scripts/protocol-localnet-smoke.ts",
    "protocol:release-check": "bun scripts/check-protocol-release.mjs"
  },
  "dependencies": {
    "@irys/web-upload": "0.0.15",
    "@irys/web-upload-solana": "0.1.8",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@solana/kit": "^6.10.0",
    "@solana/program-client-core": "^6.10.0",
    "@solana/wallet-adapter-base": "^0.9.23",
    "@solana/wallet-adapter-react": "^0.15.35",
    "@solana/wallet-adapter-react-ui": "^0.9.35",
    "@solana/web3.js": "^1.95.5",
    "@tailwindcss/postcss": "^4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "html2canvas": "^1.4.1",
    "lucide-react": "^0.461.0",
    "next": "15.5.21",
    "qrcode.react": "^4.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "sonner": "^1.7.0",
    "tailwind-merge": "^2.5.4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@codama/nodes-from-anchor": "^1.5.5",
    "@codama/renderers-js": "^2.4.0",
    "@eslint/eslintrc": "^3",
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.46",
    "@typescript-eslint/parser": "^8.46",
    "bun-types": "^1.4.0",
    "codama": "^1.10.2",
    "eslint": "^9",
    "eslint-config-next": "15.5.21",
    "postcss": "^8.4.49",
    "prettier": "3.5.3",
    "tailwindcss": "^4",
    "typescript": "^5.6.3"
  }
}
