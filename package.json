{
  "name": "tipmark",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "postinstall": "prisma generate",
    "format": "prettier --write .",
    "protocol:build": "NO_DNA=1 anchor build --ignore-keys && cp target/idl/tipmark_protocol.json idls/tipmark_protocol.json",
    "protocol:generate": "bun scripts/generate-protocol-client.mjs",
    "protocol:test": "cargo test --workspace && cargo clippy --workspace --all-targets -- -D warnings && bun test lib/protocol"
  },
  "dependencies": {
    "@edgestore/react": "^0.2.2",
    "@edgestore/server": "^0.2.2",
    "@irys/web-upload": "0.0.15",
    "@irys/web-upload-solana": "0.1.8",
    "@prisma/client": "^6.5.0",
    "@radix-ui/react-checkbox": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@solana/kit": "^6.10.0",
    "@solana/program-client-core": "^6.10.0",
    "@solana/wallet-adapter-base": "^0.9.23",
    "@solana/wallet-adapter-react": "^0.15.35",
    "@solana/wallet-adapter-react-ui": "^0.9.35",
    "@solana/wallet-adapter-wallets": "^0.19.32",
    "@solana/web3.js": "^1.95.5",
    "@tailwindcss/postcss": "^4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "html2canvas": "^1.4.1",
    "lucide-react": "^0.461.0",
    "next": "15.5.21",
    "next-auth": "^5.0.0-beta.25",
    "prettier": "^3.5.3",
    "qrcode.react": "^4.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "sonner": "^1.7.0",
    "tailwind-merge": "^2.5.4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@codama/nodes-from-anchor": "^1.5.5",
    "@codama/renderers-js": "^2.4.0",
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "bun-types": "^1.4.0",
    "codama": "^1.10.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.21",
    "postcss": "^8.4.49",
    "prisma": "^6.5.0",
    "tailwindcss": "^4",
    "typescript": "^5.6.3"
  }
}
