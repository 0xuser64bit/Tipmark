{
  // Profile and cover images come from arbitrary Arweave/IPFS gateways, so
  // next/image would need an open remotePatterns allowlist — which removes the
  // optimization it exists to provide. Plain <img> is the honest choice here.
  "extends": ["next/core-web-vitals", "next/typescript"],
  "rules": {
    "react/no-unescaped-entities": "off",
    "@next/next/no-page-custom-font": "off",
    "@next/next/no-img-element": "off"
  }
}
